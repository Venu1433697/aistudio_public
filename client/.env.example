# Example environment file for client
# Copy this to .env.production and update with your values

# API Base URL - Replace with your EC2 instance public IP or domain
VITE_API_BASE_URL=http://<YOUR_EC2_PUBLIC_IP>:4000/api

# Examples:
# VITE_API_BASE_URL=http://54.123.45.67:4000/api
# VITE_API_BASE_URL=http://yourdomain.com:4000/api
# VITE_API_BASE_URL=https://yourdomain.com/api
